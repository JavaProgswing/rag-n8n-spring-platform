        "jsCode": "const body = $json.body ?? $json;\nfor (const field of ['title', 'content']) {\n  if (!body[field] || typeof body[field] !== 'string') {\n    throw new Error(`Missing required string: ${field}`);\n  }\n}\nreturn [{ json: { title: body.title.trim(), source: (body.source ?? 'n8n-webhook').trim(), content: body.content.trim() } }];"
      }
    },
